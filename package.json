{
  "name": "conviction",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run build --workspace @conviction/mcp && vitest run",
    "test:watch": "vitest",
    "mcp:mock": "npm run build --workspace @conviction/mcp && npm exec --workspace @conviction/mcp -- conviction-mcp serve --mock",
    "mcp:init": "npm run build --workspace @conviction/mcp && npm exec --workspace @conviction/mcp -- conviction-mcp init"
  },
  "dependencies": {
    "@lifi/sdk": "^4.1.0",
    "@neondatabase/serverless": "^1.1.0",
    "@particle-network/universal-account-sdk": "^2.0.3",
    "@privy-io/node": "^0.26.0",
    "@privy-io/react-auth": "^3.32.2",
    "ai": "^7.0.9",
    "ethers": "^6.17.0",
    "next": "16.2.9",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
