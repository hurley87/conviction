# Privy — sole wallet provider (ADR 0004). Publishable app id.
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only credential used to verify profile and chat API bearer tokens.
# Enable Email as a login method in the Privy dashboard before deployment.
# Supplying the JWT verification key avoids a first-request key lookup and is
# optional. Never prefix either value with NEXT_PUBLIC_.
PRIVY_APP_SECRET=
PRIVY_JWT_VERIFICATION_KEY=

# Particle Universal Accounts — publishable keys (ADR 0004, mainnet per ADR 0001).
NEXT_PUBLIC_PARTICLE_PROJECT_ID=
NEXT_PUBLIC_PARTICLE_CLIENT_KEY=
NEXT_PUBLIC_PARTICLE_APP_ID=

# Neon serverless Postgres — feed/identity store (ADR 0009). Server-only secret.
DATABASE_URL=

# Vercel AI Gateway — LLM intent parsing (ADR 0012). Server-only secret. When
# unset, the concierge falls back to the deterministic regex parser.
AI_GATEWAY_API_KEY=

# Arbitrum RPC for the on-chain 7702 upgrade check (ADR 0005). Optional —
# defaults to the public https://arb1.arbitrum.io/rpc endpoint.
ARBITRUM_RPC_URL=
