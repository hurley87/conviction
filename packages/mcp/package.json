{
  "name": "@conviction/mcp",
  "version": "1.0.0",
  "description": "Local Model Context Protocol server for Conviction",
  "type": "module",
  "bin": {
    "conviction-mcp": "bin/conviction-mcp.js"
  },
  "exports": {
    "./setup-contract": {
      "types": "./dist/setup-contract.d.ts",
      "import": "./dist/setup-contract.js"
    },
    "./host-config": {
      "types": "./dist/host-config.d.ts",
      "import": "./dist/host-config.js"
    },
    "./agent-reads-contract": {
      "types": "./dist/agent-reads-contract.d.ts",
      "import": "./dist/agent-reads-contract.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hurley87/conviction.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/hurley87/conviction/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/hurley87/conviction/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ethers": "^6.17.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  }
}
